# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=
# Default model for new agents
AGENTOS_MODEL=claude-opus-5-5
# Set to 0 to turn off the built-in scheduler
AGENTOS_SCHEDULER=1

# Set to 1 to let HTTP tools reach private and local addresses
AGENTOS_ALLOW_PRIVATE_URLS=0

# Email tool (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Slack tool: a bot token with the chat:write scope
SLACK_BOT_TOKEN=

# Telegram tool
TELEGRAM_BOT_TOKEN=
